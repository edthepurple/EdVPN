apt update -y
apt upgrade -y
apt install build-essential -y
git clone https://github.com/OpenVPN/ovpn-backports.git
cd ovpn-backports/
bash backports-ctl.sh get-ovpn
make
make install
apt install libtool autoconf libnl-genl-3-dev pkg-config libcap-ng-dev libssl-dev liblz4-dev liblzo2-dev libpam0g-dev libtool-bin -y
sudo apt install linux-headers-$(uname -r)
wget https://swupdate.openvpn.org/community/releases/openvpn-2.7.4.tar.gz
tar -xvf openvpn-2.7.4.tar.gz
cd openvpn-2.7.4
autoreconf -vi
./configure enable_async_push=yes
make
make install
cd ~
rm -f openvpn-2.7.4.tar.gz
rm -rf openvpn-2.7.4
rm -rf ovpn-backports
sudo sh -c 'echo "[Unit]
Description=OpenVPN service
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/etc/openvpn
ExecStart=/usr/local/sbin/openvpn --config /etc/openvpn/server.conf
Restart=always

[Install]
WantedBy=multi-user.target" > /etc/systemd/system/openvpn.service'
sudo systemctl daemon-reload
cd ~
git clone https://github.com/fac/auth-script-openvpn.git
cd auth-script-openvpn
make
mv openvpn-plugin-auth-script.so /usr/local/lib/openvpn/plugins/
systemctl enable openvpn
openvpn --version
