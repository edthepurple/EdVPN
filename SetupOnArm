apt update -y
apt upgrade -y
apt install build-essential -y
apt install libtool autoconf libnl-genl-3-dev pkg-config libcap-ng-dev libssl-dev liblz4-dev liblzo2-dev libpam0g-dev libtool-bin mysql-client htop nano nload net-tools -y
sudo apt install linux-headers-$(uname -r)
wget https://swupdate.openvpn.org/community/releases/openvpn-2.7.7.tar.gz
tar -xvf openvpn-2.7.7.tar.gz
cd openvpn-2.7.7
autoreconf -vi
./configure enable_async_push=yes
make
make install
sudo mkdir -p /etc/openvpn
sudo sh -c 'echo "[Unit]
Description=OpenVPN service
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/etc/openvpn
ExecStart=/usr/local/sbin/openvpn --config /etc/openvpn/server.conf
Restart=always
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target" > /etc/systemd/system/openvpn.service'
sudo systemctl daemon-reload
cd ~
git clone https://github.com/fac/auth-script-openvpn.git
cd auth-script-openvpn
make
mv openvpn-plugin-auth-script.so /usr/local/lib/openvpn/plugins/
systemctl enable openvpn
modprobe ovpn
openvpn --version
grep -qxF ovpn /etc/modules-load.d/ovpn.conf 2>/dev/null || echo ovpn | sudo tee -a /etc/modules-load.d/ovpn.conf >/dev/null
cd ~
git clone https://github.com/edthepurple/auth.git
cd auth
make
mv auth /usr/bin/
cd ~
rm -f openvpn-2.7.7.tar.gz
rm -rf openvpn-2.7.7
rm -rf auth-script-openvpn
rm -rf auth
timedatectl set-timezone Asia/Tehran
cd ~
git clone https://github.com/edthepurple/webserver.git
cd webserver
mv websever.service /etc/systemd/system/
systemctl daemon-reload
snap install go --classic
go mod init webserver
go mod tidy
go build
mv webserver /usr/bin
systemctl enable webserver --now
